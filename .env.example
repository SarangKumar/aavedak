# --- Aavedak web (also see apps/web/.env.example) ---
# Copy secrets into gitignored .env / .env.local — never commit real values.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Neon Postgres (pooled for serverless / Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional direct (non-pooled) URL for migrations / Neon tooling
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# Neon Auth (Managed Better Auth) — Google OAuth is configured in Neon Console
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json
# openssl rand -base64 32  (≥32 chars; required for Next session cookie cache)
NEON_AUTH_COOKIE_SECRET=

# Comma-separated admin allowlist (not a secret)
ADMIN_EMAILS=example@email.com

# Optional branch label from neon link / env pull
# NEON_BRANCH=production
