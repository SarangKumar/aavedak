LOG_LEVEL=INFO
# Must equal the web app's CRON_SECRET (Vercel crons + web admin → /svc/v1/discovery/*)
CRON_SECRET=
DATABASE_URL=

# --- Job & people discovery (all optional; see docs/jobs-ingest.md) ---
# DISCOVERY_ENABLED=true
# DISCOVERY_DAILY_LIMIT=50
# JOB_EXPIRY_DAYS=30
# JUNIOR_MAX_YEARS_EXCLUSIVE=3
# INCLUDE_INTERNSHIPS=false
# DISCOVERY_SHARDS=6
# DISCOVERY_FETCH_CONCURRENCY=6
# DISCOVERY_TICK_BUDGET_SECONDS=45
# DISCOVERY_MIN_MATCH_SCORE=30
# DISCOVERY_MAX_ATTEMPTS=3
# DISCOVERY_MAX_FAILURES=5

# Public mount prefix (must match FastAPI routes + vercel.json /svc rewrite)
API_PREFIX=/svc
# App origin that fronts this API (vercel dev / production)
PUBLIC_BASE_URL=http://localhost:3000

# Shared with apps/web (same Vercel project env) — used by GET /svc/health
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
