# Aavedak web — committed template (no secrets).
# Copy to .env (production-oriented defaults) and/or .env.local (local overrides).
# Next.js load order: .env → .env.local (local wins). Never commit .env or .env.local.

# Public app origin (metadata, absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Document / FastAPI base (local default)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Better Auth (must match the origin users hit in the browser)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Web client). Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://aavedak.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local auth uses SQLite at apps/web/data/local.db (gitignored).
# Production: set AUTH_DATABASE_URL to MySQL and swap adapter in lib/auth.ts.
AUTH_DATABASE_URL=

# Comma-separated admin allowlist
ADMIN_EMAILS=sarangkumar1578@gmail.com
