# Aavedak web — committed template (no secrets).
# Copy to .env.local. Next.js load order: .env → .env.local (local wins).
# Never commit .env or .env.local.

# Public origins
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Neon Postgres (branch connection string, postgresql://…)
DATABASE_URL=

# Neon Auth (branch → Auth in the Neon Console). Google is configured there.
# Cookie secret: openssl rand -base64 32 (32+ characters).
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=

# Google Cloud Storage for resume PDFs. Required on Vercel (no local .data writes).
# Create a bucket and a service account with Storage Object Admin on that bucket.
# GCS_PRIVATE_KEY: paste the PEM, with newlines written as \n.
# Or set GCS_SERVICE_ACCOUNT_JSON to the full key JSON instead of email + private key.
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=

# Comma-separated admin allowlist
ADMIN_EMAILS=sarangkumar1578@gmail.com

# Vercel Cron bearer token for /api/cron/jobs and /api/cron/follow-ups
CRON_SECRET=

# Optional jobs ingestion. JOBS_FEED_URL is a JSON array or { "jobs": [] }.
# JOBS_INGEST_SAMPLE=1 allows the bundled sample feed (off in production).
JOBS_FEED_URL=
JOBS_INGEST_SAMPLE=
