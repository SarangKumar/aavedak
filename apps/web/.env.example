# Aavedak — committed template (no secrets).
# Copy to .env / .env.local. Never commit real values.
# Also see apps/web/.env.example (Next.js loads env from apps/web).

# --- Public ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Neon Postgres (app data + Better Auth tables) ---
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# --- Better Auth (self-hosted) + Google OAuth (+ Gmail send) ---
# openssl rand -base64 32  (≥32 chars)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Enable Gmail API + add scope gmail.send on the OAuth consent screen (see docs/gmail-oauth.md).
# Existing users must re-consent once for send + offline refresh token.

# --- Admins ---
ADMIN_EMAILS=example@email.com

# --- Google Cloud Storage (resume PDFs; required on Vercel) ---
# Prefer GCS_BUCKET + GCS_CLIENT_EMAIL + GCS_PRIVATE_KEY (one clear path).
GCS_BUCKET=aavedak-resumes
GCS_CLIENT_EMAIL=your-sa@PROJECT.iam.gserviceaccount.com
# .env / Vercel-safe: keep the double quotes and literal \n escapes (one line).
# In the Vercel dashboard, paste the INSIDE of the quotes only (BEGIN…END with real
# newlines, or the same \n-escaped string WITHOUT an extra surrounding " pair).
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Optional alternate: entire service-account JSON as one line (avoid if using PRIVATE_KEY).
# GCS_CREDENTIALS_JSON=
# Local ADC path only (not for Vercel):
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Optional / future ---
# Vercel cron: /api/cron/jobs-ingest hourly + /api/cron/process-follow-ups every 10m (Bearer CRON_SECRET)
CRON_SECRET=
JOBS_FEED_URL=
JOBS_INGEST_SAMPLE=

# Policy: first 8 Google accounts only (see apps/web/lib/user-cap.ts)
