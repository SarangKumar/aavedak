# Aavedak web — committed template (no secrets).
# Copy to .env and/or .env.local. Next.js load order: .env → .env.local (local wins).
# Never commit .env or .env.local.

# Public app origin (metadata, absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Document / FastAPI base (local default)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Neon Postgres (pooled)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# Neon Auth — Google provider is configured in Neon Console (not GOOGLE_CLIENT_* here)
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json
# Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Comma-separated admin allowlist
ADMIN_EMAILS=example@email.com

# --- Google Cloud Storage (resume PDFs; required on Vercel) ---
# Create a GCS bucket + service account with roles/storage.objectAdmin on that bucket.
GCS_BUCKET=your-aavedak-resumes-bucket
# Preferred on Vercel (paste private key with \n escaped newlines):
GCS_CLIENT_EMAIL=your-sa@PROJECT.iam.gserviceaccount.com
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Or paste the full service-account JSON as a single line:
# GCS_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Or local ADC file path (not usable on Vercel serverless):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa.json

# Product policy: only the first 8 Google accounts that successfully join
# (profiles row created) may use the app. Enforced in ensureProfile, /auth/continue,
# middleware on app routes, and app-access helpers. Message: "Aavedak is closed to new accounts."
