{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "pnpm build"
    },
    "api": {
      "root": "apps/api",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/svc",
      "destination": { "service": "api" }
    },
    {
      "source": "/svc/:path*",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/jobs-ingest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/process-follow-ups",
      "schedule": "0 7 * * *"
    }
  ]
}
